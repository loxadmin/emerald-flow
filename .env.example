# =====================================================================
# PUBLIC (bundled into the browser build — must never hold a secret)
# =====================================================================
# Supplied automatically by the Supabase connection. The publishable/anon key
# is designed to ship to the client; RLS is what protects the data.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# =====================================================================
# SERVER-ONLY (edge functions / future DigitalOcean workers)
# Set through Supabase function secrets — NEVER prefix these with VITE_.
# =====================================================================
# SUPABASE_URL                  # injected by the platform
# SUPABASE_SERVICE_ROLE_KEY     # injected by the platform. Bypasses RLS.
# INTERNAL_TASK_SECRET          # shared secret for cron/internal invocations
# RESEND_API_KEY                # transactional email
# PAYSTACK_SECRET_KEY           # payments
# LOVABLE_API_KEY               # AI gateway

# --- Optional infrastructure (NOT required today) --------------------
# Only set these if the in-memory cache / Postgres rate limiter is measured to
# be the bottleneck. Both layers are interface-driven, so enabling them is a
# provider swap, not a rewrite. See docs/ARCHITECTURE.md.
# REDIS_URL=
# REDIS_TOKEN=

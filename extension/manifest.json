{
  "manifest_version": 3,
  "name": "Karbali - AI Savings Assistant",
  "version": "2.0.0",
  "description": "Your AI-powered browser savings assistant. Discover partner merchants, maximize savings, and get intelligent shopping insights.",
  "permissions": ["activeTab", "storage", "tabs", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content.css"],
      "js": [
        "ai/intent-classifier.js",
        "ai/context-parser.js",
        "ai/conversation-manager.js",
        "ai/response-engine.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "host_permissions": [
    "https://dvkoafztquswcqniwcyf.supabase.co/*",
    "<all_urls>"
  ]
}

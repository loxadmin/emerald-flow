{
  "manifest_version": 3,
  "name": "Kabali - Earn While You Browse",
  "version": "1.0.0",
  "description": "Discover offers from brands you visit and earn rewards automatically.",
  "permissions": ["activeTab", "storage", "tabs"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "host_permissions": ["https://dvkoafztquswcqniwcyf.supabase.co/*"]
}
